# ---------------------------------------------------------------------------
# client (Next.js) — environment template
# Native dev: cp .env.example .env
# Docker:     not needed — compose injects NEXT_PUBLIC_API_BASE_URL itself
#             (this file is documentation / native-dev starter)
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle AT BUILD/DEV
# START TIME — changing them requires restarting `next dev`.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Browser-facing address of the API gateway.
#
# Native dev (gateway directly, CORS is open on the gateway):
#   run the gateway on :3000 and this app on another port, e.g. `next dev -p 3001`
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/
#
# Docker (nginx single origin on :80 routes /<service>-api/* to the gateway):
#   NEXT_PUBLIC_API_BASE_URL=http://localhost/
