# Dependencies (installed at runtime into the named volume)
node_modules

# Build output & caches
.next
out
build
*.tsbuildinfo
next-env.d.ts

# Env files (compose injects NEXT_PUBLIC_API_BASE_URL via the environment block)
.env
.env.*
!.env.example

# Host npm config (registry mirrors like hub.megan.ir) — the container must
# install from the registry pinned in compose (NPM_CONFIG_REGISTRY), not a
# host-local mirror that may be missing tarballs.
.npmrc

# Logs & debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# VCS / IDE
.git
.vscode
.idea
.DS_Store
