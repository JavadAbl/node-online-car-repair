generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Repairman {
  id             Int       @id() @default(autoincrement())
  employeeNumber String    @unique()
  firstName      String
  lastName       String
  workShift      WorkShift
  image          String?
  rating         Float     @default(0)
  profession     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id              Int    @id() @default(autoincrement())
  name            String @unique()
  description     String
  price           Int
  discountPercent Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum WorkShift {
  Morning
  Afternoon
  Evening
  Night
}

// Auth-------------------------------------------------------------------------
model Permission {
  name String         @id
  type PermissionType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  RolePermissions RolePermission[]
}

model RolePermission {
  id        Int      @id
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  permission     Permission @relation(fields: [permissionName], references: [name], onDelete: Cascade)
  permissionName String

  @@unique([role, permissionName])
}

enum Role {
  Admin
  NewUser
  Customer
  Operator
}

enum PermissionType {
  Service
  Controller
  Action
}

//Box Models-------------------------------------------------------
model InboxEvent {
  id         Int              @id @default(autoincrement())
  messageId  String           @unique()
  appId      String
  queue      String
  routingKey String
  status     InboxEventStatus @default(Pending)
  captureAt  DateTime         @default(now())
  handledAt  DateTime?
  error      String?
  payload    Json
}

model OutboxEvent {
  id         Int      @id @default(autoincrement())
  messageId  String   @unique()
  routingKey String
  publishAt  DateTime @default(now())
  payload    Json
}

enum InboxEventStatus {
  Pending
  InQueue
  Handled
  Error
}
