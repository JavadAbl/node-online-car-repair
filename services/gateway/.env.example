# ---------------------------------------------------------------------------
# gateway — environment template
# Native dev: cp .env.example .env
# Docker:     cp .env.example .env.docker  (then swap hosts — see note at bottom)
# ---------------------------------------------------------------------------

NODE_ENV=development

# HTTP server (nginx proxies to it inside compose)
HTTP_HOST=localhost
HTTP_PORT=3000

# Must match the auth service's JWT_ACCESS_SECRET (gateway verifies tokens).
JWT_ACCESS_SECRET=dev-access-secret-change-me

# Internal base URLs of the services the gateway proxies to.
# Native dev (all on localhost):
AUTH_SERVICE_URL=http://localhost:3024
VEHICLE_SERVICE_URL=http://localhost:3021
NOTIFICATION_SERVICE_URL=http://localhost:3026
CUSTOMER_SERVICE_URL=http://localhost:3023
PRODUCT_SERVICE_URL=http://localhost:3025
FACTOR_SERVICE_URL=http://localhost:3022

# ---------------------------------------------------------------------------
# Docker swaps: HTTP_HOST -> 0.0.0.0
#               <X>_SERVICE_URL host -> <x>-service (e.g. http://auth-service:3024)
# ---------------------------------------------------------------------------
