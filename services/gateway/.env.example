# ---------------------------------------------------------------------------
# gateway — committed dev config (consumed directly by compose.yaml)
# Native dev values are in the footer below.
# ---------------------------------------------------------------------------

NODE_ENV=development

# HTTP server (0.0.0.0 so nginx can reach the container)
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

# Must match the auth service's JWT_ACCESS_SECRET (gateway verifies tokens).
JWT_ACCESS_SECRET=dev-access-secret-change-me

# Internal base URLs of the services the gateway proxies to
# (compose service names on app_network).
AUTH_SERVICE_URL=http://auth-service:3024
VEHICLE_SERVICE_URL=http://vehicle-service:3021
NOTIFICATION_SERVICE_URL=http://notification-service:3026
CUSTOMER_SERVICE_URL=http://customer-service:3023
PRODUCT_SERVICE_URL=http://product-service:3025
FACTOR_SERVICE_URL=http://factor-service:3022

# ---------------------------------------------------------------------------
# Native dev (no docker): HTTP_HOST -> localhost,
# service hosts -> localhost (e.g. http://localhost:3024)
# ---------------------------------------------------------------------------
