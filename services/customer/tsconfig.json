{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  },
  "exclude": [
    "node_modules",
    "dist",
    "scripts",
    "test"
  ],
  // Hot reload inside docker: `nest start --watch` compiles with tsc's
  // watcher, but the compose bind mount (./services/customer/src) crosses
  // the Docker Desktop VM boundary, where file-system events from the host
  // never reach the container — without polling, source edits only apply
  // after a container restart. Top-level watchOptions (NOT compilerOptions —
  // tsc rejects watchFile there with TS5023); ignored by `nest build`.
  "watchOptions": {
    "watchFile": "fixedPollingInterval",
    "watchDirectory": "fixedPollingInterval",
    "fallbackPolling": "fixedInterval"
  }
}
