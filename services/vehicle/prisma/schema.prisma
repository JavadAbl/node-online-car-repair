// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/database/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Vehicle {
  id           Int              @id @default(autoincrement())
  vin          String           @unique
  make         String
  model        String
  year         Int
  trim         String
  fuelType     FuelType
  transmission TransmissionType
  engine       String
  color        String
  mileage      Int
  licensePlate String
  state        String?
  status       VehicleStatus    @default(Active)
  isDeleted    Boolean          @default(false)
  description  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  services VehicleService[]

  customer   CustomerReference @relation(fields: [customerId], references: [id])
  customerId Int
}

model VehicleService {
  id               Int      @id @default(autoincrement())
  serviceDate      DateTime
  mileageAtService Int
  technicianName   String
  description      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId Int

  service   ServiceReference @relation(fields: [serviceId], references: [id])
  serviceId Int

  technician   TechnicianReference @relation(fields: [technicianId], references: [id])
  technicianId Int
}

//Reference Tables--------------------------------------------------------
model CustomerReference {
  id        Int     @id
  firstName String?
  lastName  String?
  email     String? @unique()
  mobile    String  @unique()
  city      String?
  address   String?

  vehicles Vehicle[]
}

model ServiceReference {
  id              Int    @id
  name            String
  price           Float
  discountPercent Float

  vehicleService VehicleService[]
}

model TechnicianReference {
  id               Int    @id
  firstName        String
  lastName         String
  technicianNumber String

  vehicleServices VehicleService[]
}

// Enums-------------------------------------------------------------------------
enum FuelType {
  Gasoline
  Diesel
  Electric
  Hybrid
  PlugInHybrid
  Hydrogen
  Other
}

enum TransmissionType {
  Automatic
  Manual
  CVT
  DualClutch
  Robotic
  Other
}

enum VehicleStatus {
  Active
  InRepair
  ReadyForPickup
  Archived
  UnderWarranty
  InService
  OnLoan
  NotOperational
}

// Auth-------------------------------------------------------------------------
model Permission {
  name String         @id
  type PermissionType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  RolePermissions RolePermission[]
}

model RolePermission {
  id        Int      @id
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  permission     Permission @relation(fields: [permissionName], references: [name], onDelete: Cascade)
  permissionName String

  @@unique([role, permissionName])
}

enum Role {
  Admin
  NewUser
  Customer
  Operator
}

enum PermissionType {
  Service
  Controller
  Action
}

//Box Models-------------------------------------------------------
model InboxEvent {
  id         Int              @id @default(autoincrement())
  messageId  String           @unique()
  appId      String
  queue      String
  routingKey String
  status     InboxEventStatus @default(Pending)
  captureAt  DateTime         @default(now())
  handledAt  DateTime?
  error      String?
  payload    Json
}

model OutboxEvent {
  id         Int      @id @default(autoincrement())
  messageId  String   @unique()
  routingKey String
  publishAt  DateTime @default(now())
  payload    Json
}

enum InboxEventStatus {
  Pending
  InQueue
  Handled
  Error
}
