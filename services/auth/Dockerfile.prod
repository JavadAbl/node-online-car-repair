# syntax=docker/dockerfile:1
# Production image for the auth service (see compose prod.yaml).

# ---- build: install, generate prisma client, compile ----
FROM node:24.18-alpine AS build
WORKDIR /app

COPY package*.json ./
COPY prisma ./prisma/
COPY prisma.config.ts ./

RUN npm install --no-audit --no-fund

COPY . .

# Regenerate the prisma client (clean + idempotent), then compile to dist/.
RUN rm -rf src/infrastructure/database/generated/prisma \
    && npx prisma generate \
    && npm run build \
    && npm prune --omit=dev

# ---- runtime: compiled app + prod deps only ----
FROM node:24.18-alpine
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
# prisma CLI/schema for the boot-time schema sync (db push)
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/prisma.config.ts ./
COPY --from=build /app/package.json ./

USER node
EXPOSE 3024

# Schema sync at boot, then start. This repo has no committed migrations yet,
# so db push keeps parity with dev. NOTE: --accept-data-loss can apply
# destructive schema changes — switch to 'npx prisma migrate deploy' once
# migrations are adopted.
CMD ["sh", "-c", "npx prisma db push --accept-data-loss && node dist/index.js"]
