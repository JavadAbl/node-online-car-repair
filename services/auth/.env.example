# ---------------------------------------------------------------------------
# auth service — environment template
# Native dev: cp .env.example .env
# Docker:     cp .env.example .env.docker  (then swap hosts — see note at bottom)
# ---------------------------------------------------------------------------

NODE_ENV=development

# HTTP server
HTTP_HOST=localhost
HTTP_PORT=3024

# MySQL (credentials created by mysql-init/init.sql)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=app_user
DATABASE_PASSWORD=app_password
DATABASE_NAME=auth_db

# Redis (compose runs it with --requirepass redis_dev_pass)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_pass

# RabbitMQ (compose credentials: app_user / app_password)
RABBITMQ_URL=amqp://app_user:app_password@localhost:5672

# JWT signing secrets — CHANGE THESE for anything beyond local dev.
# JWT_ACCESS_SECRET must equal the gateway's JWT_ACCESS_SECRET
# (the gateway verifies tokens issued here).
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# ---------------------------------------------------------------------------
# Docker swaps: DATABASE_HOST=mysql  REDIS_HOST=redis
#               RABBITMQ host -> rabbitmq-host   HTTP_HOST -> 0.0.0.0
# ---------------------------------------------------------------------------
