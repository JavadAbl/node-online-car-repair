# ---------------------------------------------------------------------------
# auth service — committed dev config (consumed directly by compose.yaml)
# Native dev values are in the footer below.
# ---------------------------------------------------------------------------

NODE_ENV=development

# HTTP server (0.0.0.0 so the container is reachable on the compose network)
HTTP_HOST=0.0.0.0
HTTP_PORT=3024

# MySQL (compose service "mysql"; credentials from mysql-init/init.sql)
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_USERNAME=app_user
DATABASE_PASSWORD=app_password
DATABASE_NAME=auth_db

# Connection string used by the Prisma CLI (prisma.config.ts) for
# 'prisma db push' / migrations / seed at container boot.
# The runtime client instead uses the DATABASE_* vars above (MariaDB adapter).
DATABASE_URL=mysql://app_user:app_password@mysql:3306/auth_db

# Redis (compose service "redis", started with --requirepass redis_dev_pass)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_pass

# RabbitMQ (compose hostname rabbitmq-host; creds app_user / app_password)
RABBITMQ_URL=amqp://app_user:app_password@rabbitmq-host:5672

# JWT signing secrets — CHANGE THESE for anything beyond local dev.
# JWT_ACCESS_SECRET must equal the gateway's JWT_ACCESS_SECRET
# (the gateway verifies tokens issued here).
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# Dev mock OTP (no SMS provider yet): every SendOtp stores this fixed code
# instead of a random one — type it on the login screen to sign in.
# The code still flows through the real pipeline (TTL, cooldown, attempt
# limits). Leave empty or remove the line for random codes.
# DEV ONLY: hard-ignored (with a boot error logged) when NODE_ENV is not
# "development" — never carry this into .env.docker / production.
OTP_FIXED_CODE=123456

# Bootstrap admin: this mobile is seeded/ensured as role=Admin at every boot
# (idempotent — services/seed.service.ts):
#   - user missing          -> created as Admin + replicated downstream
#                              (customer-service profile, like a first login)
#   - user exists, not Admin -> promoted to Admin
#   - user exists as Admin  -> no-op
# Log in on the client with this mobile + the dev OTP code above to get a
# full-access account (Admin bypasses every permission check by design).
# Remove or leave empty to disable seeding — note the seed re-promotes on
# every boot while set, so demoting this account requires clearing this var.
SEED_ADMIN_MOBILE=09121234567

# ---------------------------------------------------------------------------
# Native dev (no docker): DATABASE_HOST/REDIS_HOST -> localhost,
# RABBITMQ host -> localhost, HTTP_HOST -> localhost
# ---------------------------------------------------------------------------
