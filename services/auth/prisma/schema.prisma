// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/database/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "mysql"
}

model User {
  id     Int    @id @default(autoincrement())
  mobile String @unique()
  role   Role   @default(NewUser)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  userPermissions UserPermission[]
}

model PermissionReference {
  name String         @id
  type PermissionType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  RolePermissions RolePermission[]
  userPermissions UserPermission[]
}

model UserPermission {
  id Int @id @default(autoincrement())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  permission     PermissionReference @relation(fields: [permissionName], references: [name], onDelete: Cascade)
  permissionName String
}

model RolePermission {
  id        Int      @id @default(autoincrement())
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  permission     PermissionReference @relation(fields: [permissionName], references: [name], onDelete: Cascade)
  permissionName String

  @@unique([role, permissionName])
}

// Enums-------------------------------------------------------------------------
enum Role {
  Admin
  NewUser
  Customer
  Operator
}

enum PermissionType {
  Service
  Controller
  Action
}

//Box Models-------------------------------------------------------
model InboxEvent {
  id         Int              @id @default(autoincrement())
  messageId  String           @unique()
  appId      String
  queue      String
  routingKey String
  status     InboxEventStatus @default(Pending)
  captureAt  DateTime         @default(now())
  handledAt  DateTime?
  error      Json?
  payload    Json
}

model OutboxEvent {
  id         Int      @id @default(autoincrement())
  messageId  String   @unique()
  routingKey String
  publishAt  DateTime @default(now())
  payload    Json
}

enum InboxEventStatus {
  Pending
  InQueue
  Handled
  Error
}
