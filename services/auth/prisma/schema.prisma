// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/database/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "mysql"
}

model User {
  id     Int    @id @default(autoincrement())
  mobile String @unique()
  role   Role   @default(NewUser)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  userPermissions UserPermission[]
  refreshTokens   RefreshToken[]
}

// Persisted refresh-token records (one row per issued refresh token).
// Enables rotation, revocation and replay (reuse) detection — see doc.md §3.2.
model RefreshToken {
  id        Int      @id @default(autoincrement())
  // JWT id of the refresh token this row tracks (unique per issued token).
  jti       String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  // Mirrors the JWT `exp` (used by the expired-row sweeper, not by verification).
  expiresAt  DateTime
  // Null while the token is live; set when rotated or revoked.
  revokedAt  DateTime?
  // Set on rotation: the jti of the token that replaced this one.
  replacedByJti String?
  // Audit context captured at issuance.
  ip        String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

model PermissionReference {
  name String         @id
  type PermissionType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  RolePermissions RolePermission[]
  userPermissions UserPermission[]
}

model UserPermission {
  id Int @id @default(autoincrement())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  permission     PermissionReference @relation(fields: [permissionName], references: [name], onDelete: Cascade)
  permissionName String
}

model RolePermission {
  id        Int      @id @default(autoincrement())
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  permission     PermissionReference @relation(fields: [permissionName], references: [name], onDelete: Cascade)
  permissionName String

  @@unique([role, permissionName])
}

// Enums-------------------------------------------------------------------------
enum Role {
  Admin
  NewUser
  Customer
  Operator
}

enum PermissionType {
  Service
  Controller
  Action
}

//Box Models-------------------------------------------------------
model InboxEvent {
  id         Int              @id @default(autoincrement())
  messageId  String           @unique()
  appId      String
  queue      String
  routingKey String
  status     InboxEventStatus @default(Pending)
  captureAt  DateTime         @default(now())
  handledAt  DateTime?
  error      Json?
  payload    Json
}

model OutboxEvent {
  id         Int      @id @default(autoincrement())
  messageId  String   @unique()
  routingKey String
  publishAt  DateTime @default(now())
  payload    Json
}

enum InboxEventStatus {
  Pending
  InQueue
  Handled
  Error
}
